{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queues-example",
  "main": "main.ts",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "consumers": [
      {
        "queue": "my-queue",
      },
    ],
    "producers": [
      {
        "binding": "MY_QUEUE",
        "queue": "my-queue",
      },
    ],
  },
}
