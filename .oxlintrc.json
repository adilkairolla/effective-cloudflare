{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["node_modules", "dist", "build", ".wrangler", ".output", "coverage"]
}
